generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so status/type fields below
// are plain strings constrained by the application layer (see lib/constants.ts).

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("Admin")
  createdAt     DateTime       @default(now())
  sessions      Session[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("system")
  title     String
  detail    String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Room {
  id            String   @id @default(cuid())
  number        String   @unique
  name          String
  roomType      String
  floor         Int
  status        String   @default("Available")
  pricePerNight Float
  capacity      Int
  features      String   @default("")
  createdAt     DateTime @default(now())

  reservations Reservation[]
  invoices     Invoice[]
  reviews      Review[]
}

model Reservation {
  id          String   @id @default(cuid())
  bookingCode String   @unique
  guestName   String
  guestEmail  String
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  checkIn     DateTime
  checkOut    DateTime
  guests      Int      @default(1)
  totalAmount Float
  status      String   @default("Confirmed")
  source      String   @default("Direct")
  createdAt   DateTime @default(now())

  invoices Invoice[]
}

model Staff {
  id         String   @id @default(cuid())
  staffCode  String   @unique
  name       String
  role       String
  department String
  status     String   @default("Active")
  phone      String
  email      String
  createdAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  guestName  String
  guestEmail String
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  rating     Int
  reviewText String
  source     String
  date       DateTime @default(now())
}

model Invoice {
  id            String       @id @default(cuid())
  invoiceCode   String       @unique
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  roomId        String
  room          Room         @relation(fields: [roomId], references: [id])
  guestName     String
  guestEmail    String
  checkIn       DateTime
  checkOut      DateTime
  amount        Float
  paymentMethod String
  paymentDetail String       @default("")
  status        String       @default("Pending")
  issueDate     DateTime     @default(now())
  dueDate       DateTime
}

model Report {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String
  dateStart   DateTime
  dateEnd     DateTime
  generatedOn DateTime @default(now())
}

model ScheduledReport {
  id      String  @id @default(cuid())
  name    String
  cadence String
  enabled Boolean @default(true)
}

model Settings {
  id                         String   @id @default("singleton")
  hotelName                  String   @default("Hostay Hotel")
  hotelEmail                 String   @default("info@hostay.com")
  phone                      String   @default("+1 555-123-4567")
  website                    String   @default("www.hostay.com")
  address                    String   @default("123 Hospitality Street, San Francisco, CA 94105, United States")
  currency                   String   @default("USD - US Dollar")
  timeZone                   String   @default("(UTC-08:00) Pacific Time (US & Canada)")
  dateFormat                 String   @default("MMM DD, YYYY")
  timeFormat                 String   @default("12 Hours (hh:mm A)")
  sidebarTheme               String   @default("Dark")
  primaryColor               String   @default("blue")
  maintenanceMode            Boolean  @default(false)
  allowGuestRegistration     Boolean  @default(true)
  housekeepingNotifications  Boolean  @default(true)
  autoLogoutInactiveUsers    Boolean  @default(false)
  showTutorialTips           Boolean  @default(true)
  updatedAt                  DateTime @updatedAt
}
